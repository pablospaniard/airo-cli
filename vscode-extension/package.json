{
  "name": "airo-vscode",
  "displayName": "AIRO",
  "version": "1.0.2",
  "description": "A full AIRO chat workspace in the VS Code sidebar.",
  "categories": [
    "Other"
  ],
  "keywords": [
    "ai",
    "claude",
    "codex",
    "copilot",
    "gemini",
    "orchestration"
  ],
  "homepage": "https://github.com/pablospaniard/airo-cli#readme",
  "bugs": {
    "url": "https://github.com/pablospaniard/airo-cli/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/pablospaniard/airo-cli.git"
  },
  "publisher": "pablospaniard",
  "main": "./out/extension.js",
  "scripts": {
    "compile": "tsc -p ./",
    "vscode:prepublish": "pnpm run compile",
    "package": "pnpm dlx @vscode/vsce@4.0.0 package --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/vscode": "^1.106.0",
    "typescript": "^5.8.3"
  },
  "contributes": {
    "viewsContainers": {
      "secondarySidebar": [
        {
          "id": "airo",
          "title": "AIRO",
          "icon": "media/airo.svg"
        }
      ]
    },
    "views": {
      "airo": [
        {
          "type": "webview",
          "id": "airo.sidebar",
          "name": "AIRO"
        },
        {
          "id": "airo.attachments",
          "name": "Attach Files"
        }
      ]
    },
    "commands": [
      {
        "command": "airo.runTask",
        "title": "AIRO: Run Task"
      },
      {
        "command": "airo.openHistory",
        "title": "AIRO: Open Previous Chats"
      },
      {
        "command": "airo.openTerminal",
        "title": "AIRO: Open Terminal"
      },
      {
        "command": "airo.openSettings",
        "title": "AIRO: Open Settings"
      },
      {
        "command": "airo.syncStatus",
        "title": "AIRO: Show Sync Status"
      },
      {
        "command": "airo.syncNow",
        "title": "AIRO: Sync Now"
      },
      {
        "command": "airo.jevStatus",
        "title": "AIRO: Show Jev Status"
      }
    ],
    "configuration": {
      "title": "AIRO",
      "properties": {
        "airo.command": {
          "type": "string",
          "minLength": 1,
          "default": "airo",
          "description": "AIRO executable to invoke. Use an executable path, without shell arguments."
        },
        "airo.mode": {
          "type": "string",
          "enum": [
            "auto",
            "adaptive",
            "single"
          ],
          "default": "auto",
          "description": "Routing workflow for sidebar tasks."
        },
        "airo.agent": {
          "type": "string",
          "enum": [
            "auto",
            "claude",
            "codex",
            "gemini",
            "copilot"
          ],
          "default": "auto",
          "description": "Provider to use for sidebar tasks."
        },
        "airo.tier": {
          "type": "string",
          "enum": [
            "auto",
            "fast",
            "balanced",
            "deep"
          ],
          "default": "auto",
          "description": "Model tier for sidebar tasks."
        },
        "airo.logLevel": {
          "type": "string",
          "enum": [
            "compact",
            "live",
            "verbose"
          ],
          "default": "live",
          "description": "AIRO output detail shown for sidebar tasks. Live is recommended so provider progress streams into the chat."
        },
        "airo.jevFeedback": {
          "type": "string",
          "enum": [
            "inherit",
            "disabled"
          ],
          "enumDescriptions": [
            "Use the Jev consent setting from the local AIRO configuration.",
            "Pass --no-jev for every task started from VS Code."
          ],
          "default": "inherit",
          "description": "Controls optional Jev feedback for sidebar tasks. Enabling Jev still requires explicit consent through /jev enable or the CLI."
        }
      }
    }
  },
  "activationEvents": [
    "onCommand:airo.jevStatus",
    "onCommand:airo.openHistory",
    "onCommand:airo.openSettings",
    "onCommand:airo.openTerminal",
    "onCommand:airo.runTask",
    "onCommand:airo.syncNow",
    "onCommand:airo.syncStatus",
    "onView:airo.sidebar"
  ],
  "extensionKind": [
    "workspace"
  ],
  "icon": "media/airo-icon-512.png",
  "engines": {
    "vscode": "^1.106.0"
  },
  "capabilities": {
    "virtualWorkspaces": false,
    "untrustedWorkspaces": {
      "supported": false
    }
  }
}
