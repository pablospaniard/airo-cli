{
  "name": "airo-ai-router",
  "version": "1.0.1",
  "description": "Adaptive Intelligence Routing & Orchestration for coding-agent CLIs",
  "keywords": [
    "ai",
    "claude-code",
    "cli",
    "codex",
    "copilot",
    "gemini",
    "orchestration",
    "router"
  ],
  "homepage": "https://github.com/pablospaniard/airo-cli#readme",
  "bugs": {
    "url": "https://github.com/pablospaniard/airo-cli/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pablospaniard/airo-cli.git"
  },
  "bin": {
    "ai-route": "dist/cli.js",
    "ai-router": "dist/cli.js",
    "airo": "dist/cli.js",
    "airoute": "dist/cli.js"
  },
  "files": [
    "airo.config.example.json",
    "CHANGELOG.md",
    "PRIVACY.md",
    "README.md",
    "SECURITY.md",
    "dist/*.js",
    "docs/airo-setup.png",
    "docs/jev-and-airo.md",
    "docs/routing-and-learning.md",
    "docs/routing-platform-roadmap.md"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc && chmod +x dist/cli.js",
    "dev": "tsx src/cli.ts",
    "format": "oxfmt src scripts sync-worker vscode-extension/src package.json vscode-extension/package.json tsconfig.json vscode-extension/tsconfig.json",
    "format:check": "oxfmt --check src scripts sync-worker vscode-extension/src package.json vscode-extension/package.json tsconfig.json vscode-extension/tsconfig.json",
    "lint": "oxlint --deny-warnings --tsconfig tsconfig.json src scripts vscode-extension/src && oxlint --deny-warnings --tsconfig sync-worker/tsconfig.json sync-worker/src sync-worker/test",
    "typecheck": "tsc --noEmit && tsc -p vscode-extension/tsconfig.json --noEmit && tsc -p sync-worker/tsconfig.json --noEmit",
    "test": "pnpm run test:coverage",
    "evaluate:routing-policy": "pnpm run build && node --test dist/test/routing-policy.evaluation.test.js",
    "evaluate:jev": "pnpm run build && node scripts/evaluate-routing-with-jev.mjs",
    "test:coverage": "pnpm run build && node --test --experimental-test-coverage --test-coverage-exclude=dist/test/** --test-coverage-exclude=dist/sync.js --test-coverage-lines=95 --test-coverage-functions=95 dist/test/*.test.js",
    "start": "node dist/cli.js",
    "test:sync-worker": "vitest run --config sync-worker/vitest.config.ts",
    "build:sync-worker": "wrangler deploy --dry-run --config sync-worker/wrangler.jsonc",
    "validate": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm test && pnpm run test:sync-worker && pnpm run build:sync-worker",
    "hooks:install": "git config core.hooksPath .githooks",
    "prepare": "pnpm run build",
    "package:extension": "pnpm --dir vscode-extension run package",
    "release:check": "node scripts/check-release.mjs"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.3.0",
    "@types/node": "^22.10.0",
    "oxfmt": "^0.24.0",
    "oxlint": "^1.39.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.3",
    "vitest": "^4.1.11",
    "wrangler": "^4.142.0"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@9.6.0"
}
