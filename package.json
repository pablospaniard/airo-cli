{
  "name": "@pablospaniard/airo-cli",
  "version": "0.7.1",
  "description": "Adaptive Intelligence Routing & Orchestration for Claude Code and Codex CLI",
  "keywords": [
    "ai",
    "claude-code",
    "cli",
    "codex",
    "orchestration",
    "router"
  ],
  "homepage": "https://github.com/pablospaniard/airo-cli#readme",
  "bugs": {
    "url": "https://github.com/pablospaniard/airo-cli/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pablospaniard/airo-cli.git"
  },
  "bin": {
    "ai-route": "dist/cli.js",
    "ai-router": "dist/cli.js",
    "airo": "dist/cli.js",
    "airoute": "dist/cli.js"
  },
  "files": [
    "airo.config.example.json",
    "README.md",
    "dist/*.js",
    "docs/jev-and-airo.md",
    "docs/routing-and-learning.md"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc && chmod +x dist/cli.js",
    "dev": "tsx src/cli.ts",
    "format": "oxfmt src vscode-extension/src package.json vscode-extension/package.json tsconfig.json vscode-extension/tsconfig.json",
    "format:check": "oxfmt --check src vscode-extension/src package.json vscode-extension/package.json tsconfig.json vscode-extension/tsconfig.json",
    "lint": "oxlint --deny-warnings --tsconfig tsconfig.json src vscode-extension/src",
    "typecheck": "tsc --noEmit && tsc -p vscode-extension/tsconfig.json --noEmit",
    "test": "pnpm run test:coverage",
    "test:coverage": "pnpm run build && node --test --experimental-test-coverage --test-coverage-exclude=dist/test/** --test-coverage-lines=95 --test-coverage-functions=95 dist/test/*.test.js",
    "start": "node dist/cli.js",
    "validate": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm test",
    "hooks:install": "git config core.hooksPath .githooks",
    "prepare": "pnpm run build",
    "package:extension": "pnpm --dir vscode-extension run package"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "oxfmt": "^0.24.0",
    "oxlint": "^1.39.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@9.6.0"
}
